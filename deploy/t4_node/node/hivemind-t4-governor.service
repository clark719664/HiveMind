# Idle-time governor: inference has priority; QLoRA training runs only in quiet periods and yields within seconds.
[Unit]
Description=HiveMind T4 governor (train when idle, yield to inference)
After=hivemind-boinc-client.service nginx.service

[Service]
User=callensxavier_gmail_com
# inference first: training needs 30 min of silence at night (22:00-07:00 Europe/Paris, an assumption about the owner's night) or 2 h of silence otherwise
ExecStart=/usr/bin/python3 /opt/hivemind/t4/scripts/t4_governor.py --idle-start-s 1800 --day-idle-s 7200 --night-tz Europe/Paris --night-start-h 22 --night-end-h 7
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
