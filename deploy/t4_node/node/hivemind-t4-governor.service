# Idle-time governor: inference has priority; QLoRA training runs only in quiet periods and yields within seconds.
[Unit]
Description=HiveMind T4 governor (train when idle, yield to inference)
After=hivemind-boinc-client.service nginx.service

[Service]
User=callensxavier_gmail_com
# EXPERIMENT, owner-approved on 2026-10-25 ("Keep the contributor's 5-second experiment"): training resumes after only 5 s without a request, at any hour
# (--idle-start-s 5 --day-idle-s 5), needing >= 3800 MiB of free VRAM (--min-free-mib 3800). The owner's original serving-first policy was 30 min of silence
# inside the night window (22:00-07:00 Europe/Paris) or 2 h otherwise (--idle-start-s 1800 --day-idle-s 7200 --min-free-mib 4300): restore those values to go back.
# Measured cost so far (2 real yields): 0.77 s and 7.1 s; one user request waited 7.2 s. See ../live/README.md.
ExecStart=/usr/bin/python3 /opt/hivemind/t4/scripts/t4_governor.py --idle-start-s 5 --day-idle-s 5 --min-free-mib 3800 --night-tz Europe/Paris --night-start-h 22 --night-end-h 7
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
